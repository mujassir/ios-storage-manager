// Copy to Secrets.xcconfig (git-ignored) and fill in your own values.
// See docs/SETUP.md for how to create each OAuth client.

APP_BUNDLE_ID = com.yourco.storagemanager

// Google Cloud Console → Credentials → OAuth client ID → type "iOS".
// Looks like: 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID =

// Azure portal → App registrations → Application (client) ID (a GUID).
MICROSOFT_CLIENT_ID =
